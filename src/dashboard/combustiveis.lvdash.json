{
  "datasets": [
    {
      "name": "ds_kpis",
      "displayName": "KPIs",
      "queryLines": [
        "SELECT\n",
        "  COUNT(*) AS coletas,\n",
        "  COUNT(DISTINCT cnpj_revenda) AS postos,\n",
        "  COUNT(DISTINCT uf, municipio) AS municipios,\n",
        "  DATE_FORMAT(MAX(data_coleta), 'dd/MM/yyyy') AS ultima_coleta\n",
        "FROM silver_precos\n"
      ]
    },
    {
      "name": "ds_gasolina_regiao",
      "displayName": "Gasolina por região",
      "queryLines": [
        "SELECT semana, regiao, ROUND(SUM(preco_medio * postos_pesquisados) / SUM(postos_pesquisados), 3) AS preco\n",
        "FROM gold_preco_semanal_uf\n",
        "WHERE produto = 'GASOLINA'\n",
        "GROUP BY ALL\n"
      ]
    },
    {
      "name": "ds_paridade",
      "displayName": "Paridade etanol/gasolina (última semana)",
      "queryLines": [
        "SELECT uf, paridade, preco_etanol, preco_gasolina,\n",
        "  CASE WHEN etanol_compensa THEN 'Etanol compensa' ELSE 'Gasolina compensa' END AS recomendacao\n",
        "FROM gold_paridade_etanol\n",
        "WHERE semana = (SELECT MAX(semana) FROM gold_paridade_etanol)\n"
      ]
    },
    {
      "name": "ds_gasolina_uf",
      "displayName": "Gasolina por UF (última semana)",
      "queryLines": [
        "SELECT uf, regiao, preco_medio, preco_minimo, preco_maximo, postos_pesquisados\n",
        "FROM gold_preco_semanal_uf\n",
        "WHERE produto = 'GASOLINA'\n",
        "  AND semana = (SELECT MAX(semana) FROM gold_preco_semanal_uf)\n"
      ]
    },
    {
      "name": "ds_bandeiras",
      "displayName": "Bandeira mais barata por UF",
      "queryLines": [
        "SELECT uf, bandeira, preco_medio, postos\n",
        "FROM gold_ranking_bandeiras\n",
        "WHERE produto = 'GASOLINA' AND ranking = 1 AND postos >= 5\n",
        "ORDER BY preco_medio\n"
      ]
    }
  ],
